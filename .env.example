# Telegram Bot
BOT_TOKEN=your_bot_token_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Database (SQLite по умолчанию; для PostgreSQL: postgresql+asyncpg://user:pass@host:5432/dbname)
DATABASE_URL=sqlite+aiosqlite:///data/instagram_bot.db

# Admin Telegram ID
ADMIN_TELEGRAM_ID=your_telegram_id_here

# Instagram Accounts (JSON array)
INSTAGRAM_ACCOUNTS=[{"name":"your_account","user_id":"your_ig_user_id","access_token":"your_ig_token"}]