# Telegram Bot
BOT_TOKEN=your_bot_token_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_REPORT=low
OPENAI_REASONING_CHAT=low

# Database (SQLite по умолчанию; для PostgreSQL: postgresql+asyncpg://user:pass@host:5432/dbname)
DATABASE_URL=sqlite+aiosqlite:///data/instagram_bot.db

# Admin Telegram ID
ADMIN_TELEGRAM_ID=your_telegram_id_here

# Instagram Accounts (JSON array)
INSTAGRAM_ACCOUNTS=[{"name":"your_account","user_id":"your_ig_user_id","access_token":"your_ig_token"}]

# Instagram API version (latest stable: v25.0)
INSTAGRAM_API_VERSION=v25.0

# Stories tracking (сторис живут 24ч — собираются фоновым опросом)
STORIES_POLL_ENABLED=true
STORIES_POLL_INTERVAL_HOURS=4
STORIES_INSIGHTS_WINDOW_HOURS=26

# Ежедневный авто-отчёт админу (час — локальное время сервера)
DAILY_REPORT_ENABLED=true
DAILY_REPORT_HOUR=9

# Кэш: данные старше N часов считаются стабильными и не перезапрашиваются
CACHE_FRESHNESS_HOURS=48

# Полная фоновая синхронизация БД (дневная статистика + посты)
DATA_SYNC_ENABLED=true
DATA_SYNC_INTERVAL_HOURS=6
DATA_SYNC_WINDOW_DAYS=30

# Тировое обновление инсайтов постов (экономит лимиты API):
# посты младше POSTS_HOT_DAYS — каждый цикл; до POSTS_WARM_DAYS — раз в
# POSTS_WARM_INTERVAL_HOURS; старше — заморожены
POSTS_HOT_DAYS=3
POSTS_WARM_DAYS=14
POSTS_WARM_INTERVAL_HOURS=24
